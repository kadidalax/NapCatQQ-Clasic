# License: see repository LICENSE (NapCat Limited Redistribution License).
# Maintainer: kadidalax.
# Repository: kadidalax/NapCatQQ-Clasic; frozen project brand: NapCatQQ-clasic.
# Optional root configuration overrides; both YAML files have built-in defaults.
NAPCAT_IMAGE=ghcr.io/kadidalax/napcatqq-clasic:4.18.42

# Empty: generate and persist a random 48-hex WebUI token at first start.
# Explicit values must contain at least 16 characters. This is NOT OneBot auth.
WEBUI_TOKEN=
WEBUI_BIND=127.0.0.1
WEBUI_PORT=6099
# Optional existing QQ login record; the first login still requires QR scanning.
QQ_ACCOUNT=

# Joint file only. Base compose.yaml does not inject a OneBot preset.
# In astrbot.yml: astrbot enables the preset; explicit empty disables it.
MODE=astrbot
ONEBOT_WS_URL=ws://astrbot:6199/ws
# No automatic protocol-token generation. Nonempty overrides the managed entry;
# empty preserves its existing token (a brand-new entry has no auth token).
# Set the same token in AstrBot's aiocqhttp platform. Never reuse WEBUI_TOKEN.
ONEBOT_ACCESS_TOKEN=

# Verified stable multiarchitecture image; do not replace with a moving latest.
ASTRBOT_IMAGE=soulter/astrbot:v4.29.4@sha256:72f341f0ffcf6621ef820277642c5d63955f7beeac3683433ce09cac96379c78
# These two values publish the HOST panel; container dashboard stays on 6185.
ASTRBOT_DASHBOARD_BIND=127.0.0.1
ASTRBOT_DASHBOARD_PORT=6185
# Empty is removed by the joint-file wrapper: stock generates a random password.
# Optional nonempty password: >=8 characters, uppercase + lowercase + digits.
# ASTRBOT_RESET_DASHBOARD_PASSWORD is intentionally not permanently enabled.
ASTRBOT_DASHBOARD_INITIAL_PASSWORD=
